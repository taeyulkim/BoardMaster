<Window x:Class="BoardMaster.Wpf.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BoardMaster" Height="540" Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F0E6">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="BoardMaster" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4" />
        <TextBlock Text="온톨로지 기반 보드게임 엔진" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,32" />

        <Button x:Name="GoButton" Content="바둑 (vs MCTS AI)" Width="220" Height="44" FontSize="14" Margin="0,0,0,12" Click="GoButton_Click" />
        <Button x:Name="WarButton" Content="War (카드 게임)" Width="220" Height="44" FontSize="14" Margin="0,0,0,12" Click="WarButton_Click" />
        <Button x:Name="GuryongTuButton" Content="구룡투 (심리 대전)" Width="220" Height="44" FontSize="14" Margin="0,0,0,12" Click="GuryongTuButton_Click" />
        <Button x:Name="ChessButton" Content="체스 (vs MCTS AI)" Width="220" Height="44" FontSize="14" Margin="0,0,0,12" Click="ChessButton_Click" />
        <Button x:Name="GreatKingdomButton" Content="그레이트 킹덤 (vs MCTS AI)" Width="220" Height="44" FontSize="14" Margin="0,0,0,12" Click="GreatKingdomButton_Click" />
        <Button x:Name="NineKnightsButton" Content="나인 나이츠 (vs 휴리스틱 AI)" Width="220" Height="44" FontSize="14" Click="NineKnightsButton_Click" />
    </StackPanel>
</Window>
