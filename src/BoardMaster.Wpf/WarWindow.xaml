<Window x:Class="BoardMaster.Wpf.WarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BoardMaster - War 카드 게임" Height="640" Width="740"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#0B6E4F">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="War" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,12" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="백" Foreground="White" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border Width="70" Height="100" Background="#2B2B2B" CornerRadius="6" Margin="8">
                        <TextBlock x:Name="WhiteDeckCountText" Foreground="White" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border x:Name="WhiteCardBorder" Width="70" Height="100" Background="White" CornerRadius="6" Margin="8" BorderBrush="Black" BorderThickness="2">
                        <TextBlock x:Name="WhiteCardText" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <TextBlock x:Name="RoundResultText" FontSize="17" FontWeight="Bold" Foreground="#FFD700"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Width="300" Margin="0,4" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Border x:Name="BlackCardBorder" Width="70" Height="100" Background="White" CornerRadius="6" Margin="8" BorderBrush="Black" BorderThickness="2">
                        <TextBlock x:Name="BlackCardText" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Width="70" Height="100" Background="#2B2B2B" CornerRadius="6" Margin="8">
                        <TextBlock x:Name="BlackDeckCountText" Foreground="White" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
                <TextBlock Text="흑" Foreground="White" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Column="1" Background="#08543C" CornerRadius="6" Padding="10">
                <StackPanel>
                    <TextBlock Text="라운드 기록" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ListBox x:Name="LogListBox" Height="440" FontSize="11" FontFamily="Consolas"
                             Background="#0F3D2E" Foreground="White" BorderThickness="0" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="13" Foreground="White" TextWrapping="Wrap" Margin="0,12,0,8" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="PlayRoundButton" Content="한 라운드" Width="110" Height="34" Margin="4" Click="PlayRoundButton_Click" />
            <Button x:Name="AutoPlayButton" Content="자동 재생 시작" Width="130" Height="34" Margin="4" Click="AutoPlayButton_Click" />
            <Button x:Name="NewGameButton" Content="새 게임" Width="90" Height="34" Margin="4" Click="NewGameButton_Click" />
            <Button x:Name="ViewRulesButton" Content="규칙 보기" Width="90" Height="34" Margin="4" Click="ViewRulesButton_Click" />
        </StackPanel>
    </Grid>
</Window>
