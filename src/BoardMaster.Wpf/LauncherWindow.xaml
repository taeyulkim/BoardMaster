<Window x:Class="BoardMaster.Wpf.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BoardMaster" Height="360" Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F0E6">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="BoardMaster" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4" />
        <TextBlock Text="온톨로지 기반 보드게임 엔진" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,32" />

        <Button x:Name="GoButton" Content="바둑 (vs MCTS AI)" Width="220" Height="44" FontSize="14" Margin="0,0,0,12" Click="GoButton_Click" />
        <Button x:Name="WarButton" Content="War (카드 게임)" Width="220" Height="44" FontSize="14" Click="WarButton_Click" />
    </StackPanel>
</Window>
