<Window x:Class="BoardMaster.Wpf.RulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="규칙" Height="520" Width="460"
        WindowStartupLocation="CenterOwner"
        Background="#F5F0E6">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="BodyText" FontSize="13" TextWrapping="Wrap" LineHeight="22" />
        </ScrollViewer>

        <Button Grid.Row="2" Content="닫기" Width="90" Height="30" HorizontalAlignment="Right" Margin="0,16,0,0" Click="CloseButton_Click" />
    </Grid>
</Window>
