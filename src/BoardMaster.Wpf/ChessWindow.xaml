<Window x:Class="BoardMaster.Wpf.ChessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BoardMaster - 체스" Height="720" Width="820"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F0E6">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#5C3A21" BorderThickness="3" Width="464" Height="464"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <Canvas x:Name="BoardCanvas" Width="464" Height="464" Background="Transparent"
                    MouseLeftButtonDown="BoardCanvas_MouseLeftButtonDown" />
        </Border>

        <StackPanel Grid.Column="2" VerticalAlignment="Top">
            <TextBlock Text="체스" FontSize="22" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock Text="vs 무작위 AI" FontSize="12" Foreground="Gray" Margin="0,0,0,16" />

            <TextBlock x:Name="TurnText" Text="현재 차례: White(사용자)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock x:Name="CheckText" FontSize="13" Foreground="Firebrick" Margin="0,0,0,4" />
            <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16" />

            <Button x:Name="NewGameButton" Content="새 게임" Height="32" Margin="0,0,0,8" Click="NewGameButton_Click" />
            <Button x:Name="ViewRulesButton" Content="규칙 보기" Height="32" Margin="0,0,0,24" Click="ViewRulesButton_Click" />

            <TextBlock x:Name="ResultText" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Foreground="#B71C1C" Margin="0,0,0,16" />
        </StackPanel>
    </Grid>
</Window>
