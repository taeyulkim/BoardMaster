<Window x:Class="BoardMaster.Wpf.KingsCrownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BoardMaster - 킹스 크라운" Height="720" Width="820"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#12131A">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#3A3F55" BorderThickness="3" Width="490" Height="490"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <Canvas x:Name="BoardCanvas" Width="490" Height="490" Background="Transparent"
                    MouseLeftButtonDown="BoardCanvas_MouseLeftButtonDown" />
        </Border>

        <StackPanel Grid.Column="2" VerticalAlignment="Top">
            <TextBlock Text="킹스 크라운" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,4" />
            <TextBlock Text="vs 정직한 휴리스틱 AI" FontSize="12" Foreground="#9098B0" Margin="0,0,0,16" />

            <TextBlock x:Name="TurnText" Text="현재 차례: Black(사용자)" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4" />
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,12" />

            <TextBlock Text="내 숫자칩 — 클릭해서 선택" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6" />
            <WrapPanel x:Name="ChipPanel" Margin="0,0,0,16" />

            <Button x:Name="NewGameButton" Content="새 게임" Height="32" Margin="0,0,0,8" Click="NewGameButton_Click" />
            <Button x:Name="ViewRulesButton" Content="규칙 보기" Height="32" Margin="0,0,0,16" Click="ViewRulesButton_Click" />

            <TextBlock x:Name="ResultText" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Foreground="#FFD54F" Margin="0,0,0,16" />

            <TextBlock Text="가운데 칸은 항상 비어 있지만 양쪽 왕관이 이미 놓인 것으로 간주됩니다 — 그 칸을 지나는 줄은 4칸만 채우면 빙고입니다."
                       FontSize="10" Foreground="#9098B0" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
