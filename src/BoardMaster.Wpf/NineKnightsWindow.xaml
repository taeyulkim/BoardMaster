<Window x:Class="BoardMaster.Wpf.NineKnightsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BoardMaster - 나인 나이츠" Height="800" Width="840"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#F2F4F7">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#2E3B4E" BorderThickness="3" Width="474" Height="474"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <Canvas x:Name="BoardCanvas" Width="468" Height="468" Background="Transparent"
                    MouseLeftButtonDown="BoardCanvas_MouseLeftButtonDown" />
        </Border>

        <StackPanel Grid.Column="2" VerticalAlignment="Top">
            <TextBlock Text="나인 나이츠" FontSize="22" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock Text="vs 정직한 휴리스틱 AI" FontSize="12" Foreground="Gray" Margin="0,0,0,16" />

            <TextBlock x:Name="TurnText" Text="현재 차례: Black(사용자)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />

            <Border Background="#E8ECF1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="내 비밀 정보" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock x:Name="MissionText" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock x:Name="HiddenTokenText" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="PieceCountText" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16" />

            <Button x:Name="NewGameButton" Content="새 게임" Height="32" Margin="0,0,0,8" Click="NewGameButton_Click" />
            <Button x:Name="ViewRulesButton" Content="규칙 보기" Height="32" Margin="0,0,0,16" Click="ViewRulesButton_Click" />

            <TextBlock x:Name="ResultText" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Foreground="#B71C1C" Margin="0,0,0,16" />

            <Expander x:Name="LogExpander" Header="전투/이동 기록" IsExpanded="True" FontSize="13" FontWeight="SemiBold">
                <StackPanel Margin="0,6,0,0">
                    <TextBlock Text="상대 기사의 번호는 실제로 전투가 벌어져 공개되기 전까지 '?'로 표시됩니다." FontSize="10"
                               Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <ListBox x:Name="LogListBox" Height="220" FontSize="11" FontFamily="Consolas"
                             BorderBrush="#C0C8D2" Background="#FBFBFC" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </Grid>
</Window>
