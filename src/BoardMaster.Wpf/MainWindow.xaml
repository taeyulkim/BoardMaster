<Window x:Class="BoardMaster.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BoardMaster - 9x9 바둑 vs MCTS AI" Height="760" Width="820"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F0E6">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#8B5A2B" BorderThickness="2" Background="#DEB887" CornerRadius="4"
                Width="490" Height="490" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Canvas x:Name="BoardCanvas" Width="490" Height="490" Background="Transparent"
                    MouseLeftButtonDown="BoardCanvas_MouseLeftButtonDown" />
        </Border>

        <StackPanel Grid.Column="2" VerticalAlignment="Top">
            <TextBlock Text="BoardMaster" FontSize="22" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock Text="9x9 바둑 · MCTS AI" FontSize="12" Foreground="Gray" Margin="0,0,0,16" />

            <TextBlock x:Name="TurnText" Text="현재 차례: 흑(사용자)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock x:Name="PhaseText" Text="페이즈: MainPlay" FontSize="12" Foreground="Gray" Margin="0,0,0,4" />
            <TextBlock x:Name="PrisonerText" Text="포로 - 흑: 0 / 백: 0" FontSize="12" Margin="0,0,0,16" />

            <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16" />

            <TextBlock Text="AI 난이도" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ComboBox x:Name="DifficultyComboBox" Height="28" Margin="0,0,0,20"
                      SelectedIndex="0" SelectionChanged="DifficultyComboBox_SelectionChanged">
                <ComboBoxItem Content="초급 (탐색 800회, 응답 ~1초)" Tag="800" />
                <ComboBoxItem Content="중급 (탐색 4000회, 응답 ~3초)" Tag="4000" />
                <ComboBoxItem Content="고급 (탐색 10000회, 응답 ~7초)" Tag="10000" />
            </ComboBox>

            <Button x:Name="PassButton" Content="패스" Height="32" Margin="0,0,0,8" Click="PassButton_Click" />
            <Button x:Name="NewGameButton" Content="새 게임" Height="32" Margin="0,0,0,8" Click="NewGameButton_Click" />
            <Button x:Name="ViewKifuButton" Content="기보 보기" Height="32" Margin="0,0,0,8" Click="ViewKifuButton_Click" />
            <Button x:Name="ViewRulesButton" Content="규칙 보기" Height="32" Margin="0,0,0,24" Click="ViewRulesButton_Click" />

            <TextBlock x:Name="ResultText" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Foreground="#B71C1C" Margin="0,0,0,16" />

            <Expander x:Name="CandidateExpander" Header="AI 후보수 분석 (직전 수)" IsExpanded="True" FontSize="13" FontWeight="SemiBold">
                <StackPanel Margin="0,6,0,0">
                    <TextBlock Text="방문 횟수가 많을수록 탐색이 그 수를 더 신뢰한다는 뜻입니다." FontSize="10"
                               Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <ListBox x:Name="CandidateListBox" Height="220" FontSize="11" FontFamily="Consolas"
                             BorderBrush="#C0B296" Background="#FBF8F2" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </Grid>
</Window>
